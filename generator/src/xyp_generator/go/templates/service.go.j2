package {{ group.package }}

import "{{ xyp_import }}"

// Service calls the `{{ group.name }}` group's services through one shared client.
type Service struct{ client *xyp.Client }

// New binds this group's services to client, which stays owned by the caller.
func New(client *xyp.Client) *Service { return &Service{client: client} }
