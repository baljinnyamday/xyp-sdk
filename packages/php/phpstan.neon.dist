includes:
    - ../../vendor/phpstan/phpstan-strict-rules/rules.neon
    - ../../vendor/phpstan/phpstan-phpunit/extension.neon
    - ../../vendor/phpstan/phpstan-phpunit/rules.neon

parameters:
    level: max
    paths:
        - src
        - tests
    tmpDir: .phpstan.cache
    # The generated ServiceGroups trait initialises its readonly service properties in
    # initServiceGroups(), which XypClient's constructor calls.
    additionalConstructors:
        - Xyp\XypClient::initServiceGroups
