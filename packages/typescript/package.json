{
  "name": "xyp-sdk",
  "version": "0.1.0-alpha.2",
  "description": "Typed Node.js SDK for XYP (ХУР), Mongolia's government data exchange system",
  "license": "MIT",
  "author": "baljinnyamday",
  "homepage": "https://github.com/baljinnyamday/xyp-sdk/tree/main/packages/typescript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baljinnyamday/xyp-sdk.git",
    "directory": "packages/typescript"
  },
  "bugs": "https://github.com/baljinnyamday/xyp-sdk/issues",
  "keywords": [
    "xyp",
    "khur",
    "mongolia",
    "soap",
    "sdk",
    "e-mongolia"
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:consumer": "tsc -p tests/consumer/tsconfig.esm.json && tsc -p tests/consumer/tsconfig.cjs.json"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "packageManager": "pnpm@12.3.4"
}
